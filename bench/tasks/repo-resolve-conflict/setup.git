set -eu
git switch -q -c feature
cat > settings.py <<'PY'
"""服务配置。"""

ALLOWED_ORIGINS = [
    "https://app.example.com",
    "https://partner.example.com",
]

TIMEOUT_SECONDS = 60
RETRIES = 2
LOG_LEVEL = "info"
PY
git commit -q -am "开放合作方来源，放宽超时，加日志级别"
git switch -q main
cat > settings.py <<'PY'
"""服务配置。"""

ALLOWED_ORIGINS = [
    "https://app.example.com",
    "https://admin.example.com",
]

TIMEOUT_SECONDS = 45
RETRIES = 3
PY
git commit -q -am "开放后台来源，调整超时和重试"
