# flywhl-harness 配置示例：复制为启动目录下的 flywhl.toml 后按需修改。
# 加载顺序：默认值 → ~/.flywhl/config.toml → flywhl.toml → 环境变量（FLYWHL_*）→ 命令行参数。未知字段会直接报错。
# 启动目录的配置可能来自不可信仓库：base_url、verify_command、allow 规则、hooks、mcp_servers 等设置要先信任才生效
# （终端里逐项确认，或 flywhl --trust）；-c 指定的文件与 ~/.flywhl/config.toml 视为可信。
# 工作区信任另外算：没信任过的工作区里，AGENTS.md 和读到的文件都算不可信内容，之后的写操作要人确认。
# trust_workspace = true 信任所有工作区，只能写在用户配置或 -c 文件里，这个文件里写的会被丢弃。

# 模型写成 "<供应商>:<模型>"。供应商：deepseek | dashscope | kimi | zhipu | minimax | openrouter | openai | ollama | anthropic | mock
# 不填 model 时按 provider 选择；provider = "auto" 按 DeepSeek → Anthropic → OpenAI → 百炼 → Kimi → 智谱 → MiniMax → OpenRouter
# 选第一个配置了密钥的供应商（密钥放在环境变量或启动目录的 .env 中，见 .env.example）
provider = "auto"
model = "deepseek:deepseek-flash"
# 降级链：主模型重试失败、余额不足、模型不存在时依次尝试，可以跨供应商
# fallback_models = ["deepseek:deepseek-v4-pro", "dashscope:qwen3.8-flash"]
# base_url = "https://your-proxy.example.com/v1"   # 只覆盖主模型供应商的地址
# api_key_env = "OPENROUTER_API_KEY"               # 从指定的环境变量读密钥（例如经 OpenRouter 调 Claude）
# thinking = "enabled"            # 思考开关：enabled | disabled，不填用服务默认（DeepSeek V4 默认开启）
# reasoning_effort = "high"       # 思考强度，取值以各家文档为准
max_tokens = 8192
max_retries = 4

# Stop 验收：模型想结束时运行该命令，失败则阻止结束并把输出作为缺口反馈（最多 max_stop_blocks 次）
# verify_command = "python3 -m pytest -q"
verify_todos = true
max_stop_blocks = 3

tool_timeout = 120
parallel_tool_limit = 8
cancel_grace_seconds = 5          # 不可中断工具在取消后的宽限期
snapshots = true                  # 写操作前用影子 git 打工作区快照
# 会话库落盘强度：full（默认）每次提交都刷到盘上，断电不丢已提交的事务；normal 提交更快，断电可能丢最后几次提交。
# 只覆盖会话库，影子 git 和工作区文件不在保证内。这里写的值要先信任才生效
# durability = "full"
subagent_max_depth = 2
enable_demo_tools = true          # send_notification / sleep 演示工具

[context]
# context_window = 128000         # 不填则按模型能力表
compact_threshold = 0.8
reserve_tokens = 8192
keep_recent_tokens = 12000
tool_result_max_tokens = 6000
clear_old_tool_results = true
clear_threshold = 0.55
keep_tool_results_turns = 3

[budget]
max_turns = 40
max_tool_calls = 200
# max_total_tokens = 2000000
# max_cost_usd = 1.0
# max_wall_seconds = 3600
soft_ratio = 0.8
wrap_up_on_exhaust = true

[loop_guard]
warn_repeats = 3
stop_repeats = 5
max_consecutive_errors = 6
same_file_edit_warn = 6

[permissions]
mode = "default"                  # default | accept_edits | plan | bypass
on_ask = "wait"                   # wait（等待人审）| allow | deny（无人值守）
approval_timeout = 600
strip_secret_env = true
sandbox = "auto"                  # auto（探测，用不了时拒绝执行）| macos（sandbox-exec）| linux（bubblewrap）| off：凭证位置不可读写，写操作限制在工作区与临时目录
                                  # off 只在用户配置、-c 指定的文件里生效，项目配置写的会被丢弃
sandbox_network = "auto"          # auto（沙箱开着时是 allowlist）| allow | deny | allowlist；后两档要求开启沙箱，否则 bash 拒绝执行
                                  # deny 禁止一切对外连接（含回环地址、DNS 查询与本机 Unix 套接字）
# network_allow = ["pypi.org", "files.pythonhosted.org", "*.github.com"]   # allowlist 时经本机代理只放行这些主机
# unix_sockets = ["/var/run/postgresql/.s.PGSQL.5432"]   # 沙箱里放行的本机 Unix 套接字（不能在工作区、临时目录里）；默认只放行 DNS，docker.sock、ssh-agent 都连不上
# require_pinned = true          # hook / MCP 经 npx、uvx、docker run 临时拉取的包必须锁到确切版本（镜像带 @sha256:），否则拒绝启动
rules = [
  "allow:bash(git status*)",
  "allow:bash(git diff*)",
  "allow:bash(python3 -m pytest*)",
  "deny:bash(git push*)",
]

# 进程外 hook：stdin 收到 JSON，exit 2 阻断（stderr 作为原因回给模型），协议与 Claude Code 兼容
# [[hooks]]
# event = "pre_tool_use"
# matcher = "bash"
# command = "python3 scripts/guard.py"
# fail_closed = true             # hook 崩溃或超时时按拒绝处理；不写时 pre_tool_use 为 true，其余事件为 false
# pass_env = ["SLACK_WEBHOOK_URL"]   # 子进程默认剥离密钥类环境变量；确实要用的在这里列出变量名
# env = { GUARD_LEVEL = "strict" }   # 或直接写明取值

# MCP 服务器：工具名会加上 mcp__<名字>__ 前缀
# [mcp_servers.demo]
# command = "python3"
# args = ["examples/mcp_echo_server.py"]
# read_only_tools = ["echo"]     # 按只读处理（调用不经审批）的工具，支持 * 通配
# trust_annotations = false      # 服务器自报的只读、幂等、封闭世界注解默认不采信
